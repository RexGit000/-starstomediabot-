BOT_TOKEN=your_bot_token_here
MONGODB_URI=
PORT=3000
API_ID=
API_HASH=

# Optional override (defaults are in src/constants/advertised.js)
# ADVERTISED_CHANNEL_IDS=-1003815431984,-1003384263165,-1003925770556,-1003989148295,-1003913997868

# GramJS (userbot) credentials. Obtain at my.telegram.org.
# Both are required for the 🤖 Userbot Login scene to work.
# API_ID=
# API_HASH=

# Optional: override the per-bot cache key for bot_file_ids slots.
# Defaults to the numeric prefix before the first ":" in BOT_TOKEN.
# CURRENT_BOT_KEY=default
